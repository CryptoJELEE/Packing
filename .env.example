# Supabase 설정
# Supabase 프로젝트의 URL과 API 키를 입력하세요
# https://app.supabase.com/project/_/settings/api 에서 확인 가능
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Flask 설정
# 프로덕션 환경에서는 강력한 비밀 키를 사용하세요 (예: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# 디버그 모드 (개발: True, 프로덕션: False)
FLASK_DEBUG=False

# 포트 설정 (선택사항, 기본값: 5050)
# PORT=5050
